# AI Configuration
AI_MODE=online
# Obtain your free Gemini API key from https://aistudio.google.com/app/apikey (starts with AIzaSy...)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=Camtour-On-Mistral-Ai:latest
ONLINE_API_KEY=
ONLINE_MODEL=gemini-3.5-flash-lite

# Similarity Threshold (0.80 = 80%)
SIMILARITY_THRESHOLD=0.80

# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=True
CORS_ORIGINS=["*","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5175","http://127.0.0.1:5175","http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000"]

# Database & Data Paths
SQLITE_DB_PATH=storage/conversations/conversations.db
DATA_DIR=data/tourism
VECTOR_DB_DIR=storage/vector_db

# History limit for conversation context
MAX_HISTORY_MESSAGES=10

